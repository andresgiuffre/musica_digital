msgid "Compás:"
msgstr "Measure:"

#: .\templates\base.html:176
msgid "Duración Total Reproducida:"
msgstr "Total Duration Played:"

#: .\templates\base.html:177
#, python-brace-format
msgid "{totalBeats} tiempos"
msgstr "{totalBeats} beats"

#: .\templates\base.html:178
#, python-brace-format
msgid ""
"El compás de {timeSignature} indica que hay {beatsPerMeasure} tiempos por "
"compás, y la unidad de tiempo es equivalente a {beatUnit}."
msgstr ""
"The {timeSignature} time signature indicates there are {beatsPerMeasure} "
"beats per measure, and the beat unit is equivalent to {beatUnit}."

#: .\templates\base.html:179
msgid ""
"💡 <strong>Observación Teórica:</strong> El número superior del compás "
"(numerador) indica la cantidad de tiempos. El inferior (denominador) indica "
"la figura que vale un tiempo (4 = negra, 8 = corchea, 2 = blanca)."
msgstr ""
"💡 <strong>Theory Note:</strong> The top number of the time signature "
"(numerator) indicates the number of beats. The bottom one (denominator) "
"indicates the note value worth one beat (4 = quarter note, 8 = eighth note, "
"2 = half note)."

